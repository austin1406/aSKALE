# Copy to .env.local and fill in. Never commit real values.
# Only NEXT_PUBLIC_ variables are sent to the browser.

# Supabase (added with the contact form)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
# Where new leads are sent, and the verified sender address
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Askale <hello@yourdomain.com>"

# Upstash Redis (rate limiting + cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Inngest (background jobs). Locally, run `npx inngest-cli dev` and set INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=

# Sentry (error monitoring)
NEXT_PUBLIC_SENTRY_DSN=
# Only needed on Vercel, to upload source maps
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
